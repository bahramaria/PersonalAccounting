<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Hesabyar.App.ViewModels"
             xmlns:strings="clr-namespace:Hesabyar.App.Resources.Strings"
             x:Class="Hesabyar.App.Views.CategoriesPage"
             x:DataType="viewModels:CategoriesViewModel">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="{x:Static strings:AppStrings.CategoriesHeading}" FontSize="26"
                   FontAttributes="Bold" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="{x:Static strings:AppStrings.AddCategory}"
                    Clicked="OnAddCategoryClicked" />
        </Grid>
        <Label Grid.Row="1" Text="{Binding StatusMessage}" FontSize="14" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Categories}" SelectionMode="Single"
                        SelectionChanged="OnCategorySelectionChanged">
            <CollectionView.EmptyView>
                <Label Text="{x:Static strings:AppStrings.CategoriesEmpty}"
                       HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:CategoryListItem">
                    <Border Padding="14" Margin="0,4" Stroke="#E2E2E2" StrokeThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="17" />
                            <Label Grid.Column="1" Text="{Binding TypeName}" FontSize="12"
                                   Opacity="0.7" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
