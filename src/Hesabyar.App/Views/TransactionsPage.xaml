<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Hesabyar.App.ViewModels"
             xmlns:strings="clr-namespace:Hesabyar.App.Resources.Strings"
             x:Class="Hesabyar.App.Views.TransactionsPage"
             x:DataType="viewModels:TransactionsViewModel">
    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="{x:Static strings:AppStrings.TransactionsHeading}" FontSize="26"
                   FontAttributes="Bold" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="{x:Static strings:AppStrings.AddTransaction}"
                    Clicked="OnAddTransactionClicked" />
        </Grid>
        <SearchBar Grid.Row="1" Placeholder="{x:Static strings:AppStrings.TransactionSearchPlaceholder}"
                   SearchButtonPressed="OnSearchButtonPressed" />
        <Button Grid.Row="2" Text="{x:Static strings:AppStrings.TransactionFilters}" Clicked="OnFiltersClicked" />
        <Label Grid.Row="3" Text="{Binding StatusMessage}" FontSize="13" />
        <CollectionView Grid.Row="4" ItemsSource="{Binding Transactions}" SelectionMode="Single"
                        SelectionChanged="OnTransactionSelectionChanged">
            <CollectionView.EmptyView>
                <Label Text="{x:Static strings:AppStrings.TransactionsEmpty}"
                       HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:TransactionListItem">
                    <Border Padding="14" Margin="0,4" Stroke="#E2E2E2" StrokeThickness="1">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Text="{Binding KindName}" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding AmountText}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Text="{Binding DetailText}" FontSize="12" Opacity="0.75" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding DateText}" FontSize="11"
                                   VerticalOptions="End" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
