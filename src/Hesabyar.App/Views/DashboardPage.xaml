<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Hesabyar.App.ViewModels"
             x:Class="Hesabyar.App.Views.DashboardPage"
             x:DataType="viewModels:DashboardViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="{Binding Heading}" FontSize="28" FontAttributes="Bold" />
            <Label Text="{Binding Description}" FontSize="16" />
            <Border Padding="20" StrokeThickness="1" Stroke="#E2E2E2">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding BalanceMessage}" FontSize="14" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
