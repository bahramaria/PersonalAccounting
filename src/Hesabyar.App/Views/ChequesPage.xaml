<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Hesabyar.App.ViewModels"
             xmlns:strings="clr-namespace:Hesabyar.App.Resources.Strings"
             x:Class="Hesabyar.App.Views.ChequesPage"
             x:DataType="viewModels:ChequesViewModel">
    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="{x:Static strings:AppStrings.ChequesHeading}" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="{x:Static strings:AppStrings.ChequeAdd}" Clicked="OnAddClicked" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Text="{x:Static strings:AppStrings.ChequeDueSoon}" Clicked="OnDueSevenClicked" FontSize="11" />
            <Button Grid.Column="1" Text="{x:Static strings:AppStrings.ChequeDueMonth}" Clicked="OnDueThirtyClicked" FontSize="11" />
            <Button Grid.Column="2" Text="{x:Static strings:AppStrings.ChequeCalendar}" Clicked="OnCalendarClicked" FontSize="11" />
        </Grid>
        <Label Grid.Row="2" Text="{Binding StatusMessage}" FontSize="13" />
        <CollectionView Grid.Row="3" ItemsSource="{Binding Cheques}" SelectionMode="Single" SelectionChanged="OnChequeSelected">
            <CollectionView.EmptyView>
                <Label Text="{x:Static strings:AppStrings.ChequeEmpty}" HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:ChequeListItem">
                    <Border Padding="12" Margin="0,4" Stroke="{AppThemeBinding Light={StaticResource BorderLightColor}, Dark={StaticResource BorderDarkColor}}" StrokeThickness="1">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                            <Label Text="{Binding DirectionText}" FontSize="12" Opacity="0.7" />
                            <Label Grid.Column="1" Text="{Binding StatusText}" FontSize="12" FontAttributes="Bold" />
                            <Label Grid.Row="1" Text="{Binding BankName}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding AmountText}" FontAttributes="Bold" />
                            <Label Grid.Row="2" Text="{Binding SerialNumber}" FontSize="12" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding DueDateText}" FontSize="12" />
                            <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding ReminderText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource WarningLightColor}, Dark={StaticResource WarningDarkColor}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
