<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Hesabyar.App.ViewModels"
             xmlns:strings="clr-namespace:Hesabyar.App.Resources.Strings"
             x:Class="Hesabyar.App.Views.RecurringTransactionsPage"
             x:DataType="viewModels:RecurringTransactionsViewModel">
    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="{x:Static strings:AppStrings.RecurringHeading}" FontSize="26" FontAttributes="Bold" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="{x:Static strings:AppStrings.RecurringAdd}" Clicked="OnAddClicked" />
        </Grid>
        <Label Grid.Row="1" Text="{Binding StatusMessage}" FontSize="14" />
        <Button Grid.Row="2" Text="{x:Static strings:AppStrings.RecurringPrepareDue}" Clicked="OnPrepareDueClicked" />
        <CollectionView Grid.Row="3" ItemsSource="{Binding Schedules}" SelectionMode="Single" SelectionChanged="OnScheduleSelected">
            <CollectionView.EmptyView>
                <Label Text="{x:Static strings:AppStrings.RecurringEmpty}" HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:RecurringScheduleItemViewModel">
                    <Border Padding="14" Margin="0,4" Stroke="#E2E2E2" StrokeThickness="1">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding AmountText}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Text="{Binding Kind}" FontSize="12" Opacity="0.7" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding IntervalText}" FontSize="12" />
                            <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding NextDateText}" FontSize="12" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
