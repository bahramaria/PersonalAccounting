<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Hesabyar.App.ViewModels"
             xmlns:strings="clr-namespace:Hesabyar.App.Resources.Strings"
             x:Class="Hesabyar.App.Views.AccountsPage"
             x:DataType="viewModels:AccountsViewModel">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="{x:Static strings:AppStrings.AccountsHeading}"
                   FontSize="26"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="{x:Static strings:AppStrings.AddAccount}"
                    Clicked="OnAddAccountClicked" />
        </Grid>
        <Label Grid.Row="1"
               Text="{Binding StatusMessage}"
               FontSize="14" />
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Accounts}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="{x:Static strings:AppStrings.AccountsEmpty}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontSize="16" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:AccountListItem">
                    <Border Padding="14" Margin="0,4" Stroke="#E2E2E2" StrokeThickness="1">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="17" />
                            <Label Grid.Row="1" Text="{Binding KindName}" FontSize="12" Opacity="0.7" />
                            <Label Grid.Column="1" Grid.RowSpan="2"
                                   Text="{Binding BalanceText}"
                                   VerticalOptions="Center"
                                   FontAttributes="Bold" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
