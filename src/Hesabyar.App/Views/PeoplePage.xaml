<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Hesabyar.App.ViewModels"
             xmlns:strings="clr-namespace:Hesabyar.App.Resources.Strings"
             x:Class="Hesabyar.App.Views.PeoplePage"
             x:DataType="viewModels:PeopleViewModel">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="{x:Static strings:AppStrings.PeopleHeading}" FontSize="26" FontAttributes="Bold" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="{x:Static strings:AppStrings.PersonAdd}" Clicked="OnAddPersonClicked" />
        </Grid>
        <Label Grid.Row="1" Text="{Binding StatusMessage}" FontSize="14" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding People}" SelectionMode="Single" SelectionChanged="OnPersonSelected">
            <CollectionView.EmptyView>
                <Label Text="{x:Static strings:AppStrings.PeopleEmpty}" HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:PersonListItem">
                    <Border Padding="14" Margin="0,4" Stroke="#E2E2E2" StrokeThickness="1">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" />
                            <Label Grid.Row="1" Text="{Binding BalanceDescription}" FontSize="12" Opacity="0.7" />
                            <VerticalStackLayout Grid.Column="1" Grid.RowSpan="2" Spacing="2" HorizontalOptions="End" VerticalOptions="Center">
                                <Label Text="{Binding BalanceText}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                <Label Text="{Binding Phone}" FontSize="11" Opacity="0.7" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
